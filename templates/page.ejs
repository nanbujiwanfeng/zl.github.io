<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">

  <!-- Google Fonts: Noto Sans SC + JetBrains Mono（异步加载，不阻塞渲染） -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"></noscript>

  <title><%= title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="description" content="张良的技术博客，记录编程学习与思考">
  <meta property="og:type" content="website">
<meta property="og:title" content="南不及晚风的博客">
<meta property="og:url" content="https://nanbujiwanfeng.github.io/zl.github.io/<%= ogUrlFile %>">
<meta property="og:site_name" content="南不及晚风的博客">
<meta property="og:locale" content="zh_CN">
<meta property="article:author" content="张良">
<meta name="twitter:card" content="summary">

  <link rel="shortcut icon" href="/zl.github.io/favicon.png">
  <link rel="alternate" type="application/rss+xml" title="南不及晚风的博客 RSS" href="/zl.github.io/rss.xml">

  <!-- 预加载首张 banner 图（LCP 关键资源，WebP 优先） -->
  <link rel="preload" as="image" href="/zl.github.io/images/1.webp" fetchpriority="high" imagesrcset="/zl.github.io/images/1-400w.webp 400w, /zl.github.io/images/1-800w.webp 800w, /zl.github.io/images/1-1200w.webp 1200w" imagesizes="100vw">

  <link rel="stylesheet" href="/zl.github.io/css/reset.css?v=<%= version %>">
  <link rel="stylesheet" href="/zl.github.io/css/theme.css?v=<%= version %>">
  <link rel="stylesheet" href="/zl.github.io/css/content.css?v=<%= version %>">
  <link rel="stylesheet" href="/zl.github.io/css/fork-awesome.min.css?v=<%= version %>">
  <link rel="stylesheet" href="/zl.github.io/css/style.css?v=<%= version %>">

<body>

  <!-- 阅读进度条 -->
  <div id="reading-progress"></div>
  <div id="container">
    <div id="wrap">
      <!-- ========== 页面头部 ========== -->
      <header id="header">
  <div id="banner"></div>
  <div id="header-outer" class="container">
    <div id="header-title" class="row">
      <h1 id="logo-wrap">
        <a href="/zl.github.io/" id="logo">南不及晚风的博客</a>
      </h1>

    </div>
    <div id="header-inner" class="row">
      <nav id="main-nav">
        <a id="main-nav-toggle" class="nav-icon"><span class="fa fa-bars"></span></a>

          <a class="main-nav-link" href="/zl.github.io/">Home</a>

          <a class="main-nav-link" href="/zl.github.io/archives">Archives</a>

      </nav>
      <nav id="sub-nav">


        <a class="nav-icon nav-search-btn" title="搜索"><span class="fa fa-search"></span></a>
      </nav>
      <div id="search-form-wrap">
        <form action="//google.com/search" method="get" accept-charset="UTF-8" class="search-form"><input type="search" name="q" class="search-form-input" placeholder="搜索"><button type="submit" class="search-form-submit">&#xF002;</button><input type="hidden" name="sitesearch" value="https://nanbujiwanfeng.github.io/zl.github.io"></form>
      </div>
    </div>
  </div>
</header>

      <div class="container">
        <section id="main">
          <%- articlesHtml %>
          <%- pageNavHtml %>
          <% if (showComments) { %>
          <!-- ========== Giscus 评论区 ========== -->
          <div id="giscus-container">
            <script src="https://giscus.app/client.js"
              data-repo="nanbujiwanfeng/zl.github.io"
              data-repo-id="R_kgDORuHXBQ"
              data-category="Announcements"
              data-category-id="DIC_kwDORuHXBc4C_RHU"
              data-mapping="pathname"
              data-strict="0"
              data-reactions-enabled="1"
              data-emit-metadata="0"
              data-input-position="bottom"
              data-theme="preferred_color_scheme"
              data-lang="zh-CN"
              crossorigin="anonymous"
              async>
            </script>
          </div>
          <% } %>
        </section>

          <!-- ========== 侧边栏 ========== -->
          <aside id="sidebar">





  <div class="widget-wrap">
    <h3 class="widget-title">标签</h3>
    <div class="widget">
      <ul class="tag-list" itemprop="keywords"><li class="tag-list-item"><a class="tag-list-link" href="/zl.github.io/tags/C语言/" rel="tag">C语言</a></li><li class="tag-list-item"><a class="tag-list-link" href="/zl.github.io/tags/HTML/" rel="tag">HTML</a></li><li class="tag-list-item"><a class="tag-list-link" href="/zl.github.io/tags/javascript/" rel="tag">javascript</a></li><li class="tag-list-item"><a class="tag-list-link" href="/zl.github.io/tags/frontend/" rel="tag">前端</a></li></ul>
    </div>
  </div>




  <div class="widget-wrap">
    <h3 class="widget-title">标签云</h3>
    <div class="widget tagcloud">
      <a href="/zl.github.io/tags/C语言/" style="font-size: 15px;">C语言</a> <a href="/zl.github.io/tags/HTML/" style="font-size: 10px;">HTML</a> <a href="/zl.github.io/tags/javascript/" style="font-size: 10px;">javascript</a> <a href="/zl.github.io/tags/frontend/" style="font-size: 10px;">前端</a>
    </div>
  </div>




  <div class="widget-wrap">
    <h3 class="widget-title">归档</h3>
    <div class="widget">
      <ul class="archive-list"><li class="archive-list-item"><a class="archive-list-link" href="/zl.github.io/archives/2026/april/">四月 2026</a></li><li class="archive-list-item"><a class="archive-list-link" href="/zl.github.io/archives/2026/march/">三月 2026</a></li></ul>
    </div>
  </div>




  <div class="widget-wrap">
    <h3 class="widget-title">最新文章</h3>
    <div class="widget">
      <ul>
        <% recentPosts.forEach(function(p) { %>
          <li>
            <a href="<%= p.url %>"><%= p.title %></a>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

  <% if (showFriends && friends && friends.length > 0) { %>
  <div class="widget-wrap">
    <h3 class="widget-title">友链</h3>
    <div class="widget">
      <ul class="friend-list">
        <% friends.forEach(function(f) { %>
        <li class="friend-item">
          <a href="<%= f.url %>" target="_blank" rel="noopener noreferrer" class="friend-link">
            <span class="friend-avatar"></span>
            <span class="friend-info">
              <span class="friend-name"><%= f.name %></span>
              <span class="friend-desc"><%= f.description %></span>
            </span>
          </a>
        </li>
        <% }); %>
      </ul>
      <a href="/zl.github.io/friends/" class="friend-more">查看更多友链 →</a>
    </div>
  </div>
  <% } %>


</aside>

      </div>

      <!-- ========== 页脚 ========== -->
      <footer id="footer">

  <div class="container">
    <div id="footer-info" class="row">

      &copy; 2026 张良<br>
    </div>
  </div>
  <div class="container">
    <% if (isHome) { %>
    <div id="busuanzi-stats" style="text-align:center;color:#94a3b8;font-size:0.82em;padding:8px 0;">
      <span>本站总访问量 <span id="busuanzi_value_site_pv">-</span> 次</span>
      <span style="margin:0 12px;">|</span>
      <span>总访客数 <span id="busuanzi_value_site_uv">-</span> 人</span>
    </div>
    <script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    <% } %>
  </div>
</footer>

    </div>

    <!-- ========== 移动端导航菜单 ========== -->
    <nav id="mobile-nav">

    <a href="/zl.github.io/" class="mobile-nav-link">Home</a>

    <a href="/zl.github.io/archives" class="mobile-nav-link">Archives</a>

</nav>



<!-- ========== 脚本加载 ========== -->








<script defer src="/zl.github.io/js/tokenize.js?v=<%= version %>"></script>
<script defer src="/zl.github.io/js/script.js?v=<%= version %>"></script>





  </div>

  <!-- 回到顶部按钮 -->
  <button id="back-to-top" title="回到顶部" aria-label="回到顶部">
    <span class="fa fa-chevron-up"></span>
  </button>
</body>
</html>